<Window x:Class="mini2nbrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:mini2nbrowser"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="2ⁿ Browser" Height="720" Width="1180"
        Icon="/app.ico"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        Background="{DynamicResource WindowBg}"
        MinHeight="400" MinWidth="700"
        FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:NonZeroToVisibilityConverter x:Key="NonZeroToVisible"/>

        <!-- 现代圆角 ContextMenu 样式 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ToolbarBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="Black"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <ScrollViewer Margin="0,2" CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代 MenuItem 样式 -->
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Input"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="0,0,8,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ContentSource="Icon"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"
                                           Opacity="0.5" FontSize="11" Margin="20,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代 Separator 样式 -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- 搜索引擎列表项模板 -->
        <DataTemplate x:Key="SearchEngineItemTemplate">
            <Grid Height="36" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="24" Height="24">
                    <Ellipse Fill="{Binding IconColor}"/>
                    <TextBlock Text="{Binding IconText}" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextColor}"/>
                    <TextBlock FontSize="10" Opacity="0.5" Foreground="{DynamicResource TextColor}">
                        <Run Text="关键字: "/>
                        <Run Text="{Binding Keyword}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="默认" FontSize="10" Foreground="{DynamicResource AccentBlue}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="3" Content="删除" Width="50" Height="24" FontSize="11"
                        Tag="{Binding Name}" Click="BtnDeleteEngine_Click"/>
            </Grid>
        </DataTemplate>

        <!-- 密码列表项模板 -->
        <DataTemplate x:Key="PasswordItemTemplate">
            <Border Background="{DynamicResource ToolbarBg}" CornerRadius="8" Padding="12" Margin="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Site}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="{Binding Username}" FontSize="11" Opacity="0.6"
                                   Foreground="{DynamicResource TextColor}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="删除" Width="50" Height="24" FontSize="11"
                            Tag="{Binding Site}" Click="BtnDeletePassword_Click"
                            ToolTip="删除此密码记录"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 脚本列表项模板 -->
        <DataTemplate x:Key="ScriptItemTemplate">
            <Border Background="{DynamicResource ToolbarBg}" CornerRadius="8" Padding="12" Margin="0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 系统托盘图标 -->
        <tb:TaskbarIcon x:Key="TrayIcon"
            IconSource="/app.ico"
            ToolTipText="mini2n Browser v1.3.0">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示浏览器" Click="TrayShowWindow_Click"/>
                    <Separator/>
                    <MenuItem Header="完全退出" Click="TrayExitApp_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid x:Name="rootGrid" Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部导航栏（固定，全宽） -->
        <Grid x:Name="navBar" Grid.Row="0" Background="{DynamicResource ToolbarBg}"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              PreviewMouseLeftButtonDown="NavBar_PreviewMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：前进/后退/刷新/停止/主页 + 地址栏 -->
            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="btnBack" Click="BtnBack_Click" Style="{DynamicResource ToolButton}"
                        Width="32" Height="32" IsEnabled="False" ToolTip="后退">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Stroke="{DynamicResource TextColor}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M15 6l-6 6 6 6"/>
                </Button>
                <Button Grid.Column="1" x:Name="btnForward" Click="BtnForward_Click" Style="{DynamicResource ToolButton}"
                        Width="32" Height="32" IsEnabled="False" ToolTip="前进" Margin="2,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Stroke="{DynamicResource TextColor}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M9 6l6 6-6 6"/>
                </Button>
                <Button Grid.Column="2" x:Name="btnReload" Click="BtnReload_Click" Style="{DynamicResource ToolButton}"
                        Width="32" Height="32" ToolTip="刷新" Margin="2,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextColor}"
                          Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </Button>
                <Button Grid.Column="3" x:Name="btnStop" Click="BtnStop_Click" Style="{DynamicResource ToolButton}"
                        Width="32" Height="32" Visibility="Collapsed" ToolTip="停止" Margin="2,0,0,0">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{DynamicResource TextColor}"
                          Data="M6 6h12v12H6z"/>
                </Button>
                <Button Grid.Column="4" x:Name="btnHome" Click="BtnHome_Click" Style="{DynamicResource ToolButton}"
                        Width="32" Height="32" ToolTip="主页" Margin="2,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextColor}"
                          Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </Button>
                <TextBox Grid.Column="5" x:Name="txtUrl" Height="32" Margin="8,0,4,0" HorizontalAlignment="Stretch"
                         Style="{DynamicResource UrlBox}" KeyDown="TxtUrl_KeyDown"
                         TextChanged="TxtUrl_TextChanged"
                         LostFocus="TxtUrl_LostFocus"
                         VerticalContentAlignment="Center" FontSize="13"/>
                <!-- 无痕模式指示图标 -->
                <Path Grid.Column="6" x:Name="iconIncognito" Width="16" Height="16" Stretch="Uniform"
                      Margin="4,0,0,0" Visibility="Collapsed"
                      Fill="#8B5CF6" VerticalAlignment="Center"
                      Data="M12 1C7 1 3 5 3 10v2h18v-2c0-5-4-9-9-9zM7 13c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm10 0c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3z"/>
            </Grid>

            <!-- 右侧：收藏/下载/更多/窗口控制 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="btnBookmark" Click="BtnBookmark_Click" Style="{DynamicResource ToolButton}"
                        Width="32" Height="32" ToolTip="添加书签 (Ctrl+D)">
                    <Path x:Name="iconBookmark" Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextColor}"
                          Data="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z"/>
                </Button>
                <Button x:Name="btnBookmarksList" Click="BtnBookmarksList_Click"
                        Style="{DynamicResource ToolButton}" Width="32" Height="32" ToolTip="收藏夹">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextColor}"
                          Data="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/>
                </Button>
                <Grid Width="32" Height="32">
                    <Button x:Name="btnDownloads" Click="BtnDownloads_Click"
                            Style="{DynamicResource ToolButton}" Width="32" Height="32" ToolTip="下载">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource TextColor}"
                              Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                    </Button>
                    <Border x:Name="downloadBadge" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{DynamicResource AccentBlue}" CornerRadius="8"
                            Width="16" Height="16" Margin="0,2,2,0">
                        <TextBlock x:Name="downloadBadgeText" Text="" FontSize="9"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                </Grid>
                <!-- 媒体嗅探按钮 -->
                <Grid Width="32" Height="32">
                    <Button x:Name="btnMediaSniffer" Click="BtnMediaSniffer_Click"
                            Style="{DynamicResource ToolButton}" Width="32" Height="32" ToolTip="媒体嗅探">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource TextColor}"
                              Data="M12 2a3 3 0 0 1 3 3v9a3 3 0 1 1-6 0V5a3 3 0 0 1 3-3zM8 9H6a1 1 0 0 0 0 2h2v3a4 4 0 0 0 8 0v-3h2a1 1 0 1 0 0-2h-2V7h2a1 1 0 1 0 0-2h-3v9a2 2 0 1 1-4 0V5h2a1 1 0 0 0 0-2H6a1 1 0 0 0 0 2h2z"/>
                    </Button>
                    <Border x:Name="mediaBadge" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#e74c3c" CornerRadius="8"
                            Width="16" Height="16" Margin="0,2,2,0">
                        <TextBlock x:Name="mediaBadgeText" Text="" FontSize="9"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                </Grid>
                <!-- 更多按钮 -->
                <Button x:Name="btnMore" Click="BtnMore_Click"
                        Style="{DynamicResource ToolButton}" Width="32" Height="32" ToolTip="更多">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextColor}"
                          Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建无痕标签页" InputGestureText="Ctrl+Shift+N" Click="BtnIncognito_Click"/>
                            <Separator/>
                            <MenuItem Header="打开本地 PDF..." Click="BtnOpenPdf_Click"/>
                            <MenuItem Header="网页截图（整页）..." Click="BtnCapturePage_Click"/>
                            <MenuItem Header="全屏模式" InputGestureText="F11" Click="BtnToggleFullscreen_Click"/>
                            <Separator/>
                            <MenuItem x:Name="menuForceDark" Header="强制暗色网页（当前标签）" IsCheckable="True" Click="MenuForceDark_Click"/>
                            <Separator/>
                            <MenuItem Header="阅读模式（当前标签）" InputGestureText="Ctrl+Shift+R" Click="MenuReaderMode_Click"/>
                            <MenuItem Header="画中画（当前页视频）" Click="MenuPictureInPicture_Click"/>
                            <MenuItem Header="生成当前页二维码..." Click="MenuQrCode_Click"/>
                            <Separator/>
                            <MenuItem Header="密码管理" Click="BtnPasswords_Click"/>
                            <MenuItem Header="扩展管理" Click="BtnExtensions_Click"/>
                            <Separator/>
                            <MenuItem Header="设置" Click="BtnSettings_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="btnMinimize" Click="BtnMinimize_Click"
                        Style="{DynamicResource CaptionBtn}" Width="46" Height="44">
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource TextColor}" StrokeThickness="1.5"
                          Data="M0 5h10"/>
                </Button>
                <Button x:Name="btnMaximize" Click="BtnMaximize_Click"
                        Style="{DynamicResource CaptionBtn}" Width="46" Height="44">
                    <Path x:Name="iconMaximize" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource TextColor}" StrokeThickness="1.5"
                          Data="M0.5 0.5h9v9h-9z"/>
                </Button>
                <Button x:Name="btnClose" Click="BtnClose_Click"
                        Style="{DynamicResource CaptionCloseBtn}" Width="46" Height="44">
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource TextColor}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M0 0l10 10M10 0L0 10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 地址栏联想下拉 Popup (v1.5) ===== -->
        <!-- 说明：Popup 挂在 Window 的根层级（PlacementTarget=txtUrl，Bottom 对齐），
             这样宽度可以跟随 txtUrl；内部 ListBox 键盘上下/Enter/ESC 已在代码层处理 -->
        <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=txtUrl}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="2">
            <Border Background="{DynamicResource ToolbarBg}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="6" Padding="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <ListBox x:Name="SuggestListBox"
                         MaxHeight="360"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SuggestListBox_SelectionChanged"
                         PreviewKeyDown="SuggestListBox_PreviewKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                CornerRadius="4"
                                                Background="Transparent"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ColorAnimation
                                                                Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                Duration="0"
                                                                To="#1A0078D4"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ColorAnimation
                                                                Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                Duration="0"
                                                                To="#260078D4"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AddressSuggestItem}">
                            <Grid Width="{Binding ActualWidth,
                                ElementName=SuggestListBoxPresenterProxy, Mode=OneWay, FallbackValue=560}"
                                  Margin="8,5" MaxWidth="1200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 来源图标色块 -->
                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4"
                                        Background="{Binding SourceColor}"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SourceLabel}"
                                               Foreground="White" FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- 文字 / URL -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{DynamicResource TextColor}"
                                               FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               FontSize="11" Opacity="0.85"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- 右侧箭头（或提示） -->
                                <Path Grid.Column="2" Width="14" Height="14"
                                      Margin="8,0,2,0" Opacity="0.35"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource TextColor}"
                                      Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <!-- 自定义模板：通过代理把控件 ActualWidth 暴露给 ItemTemplate -->
                            <Border Background="Transparent">
                                <Grid>
                                    <local:WidthProxy x:Name="SuggestListBoxPresenterProxy"
                                                      Source="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Border>
        </Popup>

        <!-- 下方区域：侧边栏 + 网页内容 -->
        <Grid Grid.Row="1">
            <!-- 左侧标签栏（垂直标签 + 搜索 + 分组） -->
            <Grid x:Name="tabSidebar" Width="32" Background="{DynamicResource ToolbarBg}"
                  HorizontalAlignment="Left"
                  MouseEnter="TabSidebar_MouseEnter" MouseLeave="TabSidebar_MouseLeave">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标签搜索框（展开时显示） -->
                <TextBox x:Name="txtTabSearch" Grid.Row="0" Height="28" Margin="3,3,3,3"
                         Visibility="Collapsed" FontSize="12"
                         Style="{DynamicResource UrlBox}"
                         VerticalContentAlignment="Center"
                         ToolTip="搜索标签页标题"
                         TextChanged="TxtTabSearch_TextChanged"/>

                <ListBox x:Name="tabList" Grid.Row="1" Background="Transparent"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="TabList_SelectionChanged" MouseDown="TabList_MouseDown"
                         ContextMenuOpening="TabList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="分配到分组..." Click="MenuItemAssignGroup_Click"/>
                            <MenuItem Header="移出分组" Click="MenuItemRemoveGroup_Click"/>
                            <Separator/>
                            <MenuItem Header="冻结此标签" Click="MenuItemFreezeTab_Click"/>
                            <MenuItem Header="关闭分组内所有标签" Click="MenuItemCloseGroup_Click"/>
                            <Separator/>
                            <MenuItem Header="静音/取消静音此标签" Click="MenuItemMuteTab_Click"/>
                            <MenuItem Header="复制标签 URL" Click="MenuItemCopyTabUrl_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Height="28">
                                            <Grid>
                                                <!-- 折叠视图：居中 favicon -->
                                                <Grid x:Name="collapsedView" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="18" Height="18">
                                                        <Path Width="16" Height="16" Stretch="Uniform"
                                                              Fill="{DynamicResource TextColor}"
                                                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                                                        <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Grid>
                                                <!-- 展开视图：favicon + 标题 + 关闭 -->
                                                <Grid x:Name="expandedView" Visibility="Collapsed" Margin="6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                                                        <Path Width="16" Height="16" Stretch="Uniform"
                                                              Fill="{DynamicResource TextColor}"
                                                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                                                        <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               VerticalAlignment="Center" Margin="6,0,2,0"
                                                               TextTrimming="CharacterEllipsis" FontSize="12"
                                                               Foreground="{DynamicResource TextColor}"/>
                                                    <Button Grid.Column="2" Width="20" Height="20"
                                                            Click="CloseTab_Click" Tag="{Binding Id}"
                                                            Style="{DynamicResource ToolButton}"
                                                            VerticalAlignment="Center" ToolTip="关闭标签">
                                                        <Path Width="8" Height="8" Stretch="Uniform"
                                                              Stroke="{DynamicResource TextColor}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M0 0l10 10M10 0L0 10"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="collapsedView" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="expandedView" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 底部工具栏：搜索、折叠分组、冻结（Row=2） -->
                <StackPanel Grid.Row="2" Margin="3,3,3,2">
                    <Button x:Name="btnTabSearch" Click="BtnTabSearch_Click"
                            Height="28" HorizontalAlignment="Stretch" ToolTip="搜索标签"
                            BorderThickness="0" Background="Transparent" Padding="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#00000000" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#263b82f6"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#4d3b82f6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Fill="{DynamicResource TextColor}"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            <TextBlock x:Name="txtSearchLabel" Grid.Column="1" Text="搜索标签"
                                       FontSize="11" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColor}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="btnCollapseGroups" Click="BtnCollapseGroups_Click"
                            Height="28" HorizontalAlignment="Stretch" ToolTip="折叠/展开分组"
                            BorderThickness="0" Background="Transparent" Padding="0" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#00000000" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#263b82f6"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#4d3b82f6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Fill="{DynamicResource TextColor}"
                                  Data="M7 10l5 5 5-5z"/>
                            <TextBlock x:Name="txtCollapseLabel" Grid.Column="1" Text="折叠分组"
                                       FontSize="11" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColor}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="btnFreezeIdle" Click="BtnFreezeIdle_Click"
                            Height="28" HorizontalAlignment="Stretch" ToolTip="冻结闲置标签"
                            BorderThickness="0" Background="Transparent" Padding="0" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#00000000" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#263b82f6"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#4d3b82f6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Fill="{DynamicResource TextColor}"
                                  Data="M22 11h-4.17l2.59-2.59L19 7l-5 5 5 5 1.41-1.41L17.83 13H22v-2zM2 13h4.17l-2.59 2.59L5 17l5-5-5-5-1.41 1.41L6.17 9H2v4z"/>
                            <TextBlock x:Name="txtFreezeLabel" Grid.Column="1" Text="冻结闲置"
                                       FontSize="11" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColor}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 新建标签按钮（Row=3） 主按钮风格：蓝色高亮 -->
                <Button x:Name="btnNewTab" Grid.Row="3" Click="BtnNewTab_Click"
                        Height="34" HorizontalAlignment="Stretch"
                        Margin="3,2,3,5"
                        HorizontalContentAlignment="Left"
                        ToolTip="新建标签 (Ctrl+T)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3b82f6"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2563eb"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M0 8h16M8 0v16" Margin="-2,0,0,0"/>
                        <TextBlock x:Name="txtNewTabLabel" Grid.Column="1" Text="新建标签页" FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="White"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- 网页区域 -->
            <Grid x:Name="webArea" Margin="38,6,6,6">
                <Grid x:Name="webViewContainer"/>
                <!-- 页内查找栏（v1.8 新增）：右上浮层 -->
                <Border x:Name="findBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="Collapsed" Margin="0,6,6,0"
                        Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="8" Padding="6,4" Panel.ZIndex="100">
                    <DockPanel>
                        <Button x:Name="btnFindClose" DockPanel.Dock="Right" Width="22" Height="22"
                                ToolTip="关闭查找（Esc）" Click="BtnFindClose_Click"
                                Background="Transparent" BorderThickness="0">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Fill="{DynamicResource TextColor}"
                                  Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                        </Button>
                        <TextBlock x:Name="findStatus" DockPanel.Dock="Right"
                                   VerticalAlignment="Center" Margin="6,0,6,0"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <Button x:Name="btnFindPrev" DockPanel.Dock="Right" Width="22" Height="22"
                                ToolTip="上一个 (Shift+F3)" Click="BtnFindPrev_Click"
                                Background="Transparent" BorderThickness="0">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Fill="{DynamicResource TextColor}"
                                  Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
                        </Button>
                        <Button x:Name="btnFindNext" DockPanel.Dock="Right" Width="22" Height="22"
                                ToolTip="下一个 (F3)" Click="BtnFindNext_Click"
                                Background="Transparent" BorderThickness="0">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Fill="{DynamicResource TextColor}"
                                  Data="M7.41 8.59L12 13.17l4.59-4.58L18 9l-6 6-6-6z"/>
                        </Button>
                        <TextBox x:Name="findInput" Width="200" Margin="0,0,4,0"
                                 Padding="6,3" FontSize="13"
                                 KeyDown="FindInput_KeyDown"/>
                    </DockPanel>
                </Border>
                <!-- 阅读模式浮层（v1.9 新增）：全屏覆盖，提取正文纯文本阅读 -->
                <Border x:Name="readerOverlay"
                        Visibility="Collapsed" Panel.ZIndex="200"
                        Background="{DynamicResource WindowBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ToolbarBg}"
                                Padding="16,10" BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button x:Name="btnReaderClose" DockPanel.Dock="Right"
                                        Width="28" Height="28" ToolTip="关闭阅读模式（Esc）"
                                        Click="BtnReaderClose_Click"
                                        Background="Transparent" BorderThickness="0">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Fill="{DynamicResource TextColor}"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button x:Name="btnReaderFontMinus" Width="28" Height="28"
                                            ToolTip="缩小字号" Click="BtnReaderFontMinus_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Content="A-" FontSize="11"/>
                                    <Button x:Name="btnReaderFontPlus" Width="28" Height="28" Margin="4,0,0,0"
                                            ToolTip="放大字号" Click="BtnReaderFontPlus_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Content="A+" FontSize="11"/>
                                    <Button x:Name="btnReaderTheme" Width="28" Height="28" Margin="4,0,0,0"
                                            ToolTip="切换阅读主题（浅/深/黄）" Click="BtnReaderTheme_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Content="○" FontSize="14"/>
                                </StackPanel>
                                <TextBlock x:Name="readerTitle" DockPanel.Dock="Left"
                                           VerticalAlignment="Center" FontSize="13"
                                           Text="阅读模式" Foreground="{DynamicResource TextColor}"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="40,24" x:Name="readerScroll"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                                <TextBlock x:Name="readerHeadline" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource TextColor}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock x:Name="readerByline" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Margin="0,0,0,24" TextWrapping="Wrap"/>
                                <TextBlock x:Name="readerContent" FontSize="17"
                                           FontFamily="Segoe UI"
                                           Foreground="{DynamicResource TextColor}"
                                           TextWrapping="Wrap" LineHeight="28"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- 二维码弹窗（v1.9 新增）：居中遮罩 -->
                <Border x:Name="qrOverlay" Visibility="Collapsed" Panel.ZIndex="300"
                        Background="#80000000"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border Background="{DynamicResource ToolbarBg}"
                            CornerRadius="12" Padding="20"
                            Width="320" VerticalAlignment="Center" HorizontalAlignment="Center"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="btnQrClose" Grid.Row="0" Width="28" Height="28"
                                    ToolTip="关闭" Click="BtnQrClose_Click"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Panel.ZIndex="10" Margin="0,-12,-12,0">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextColor}"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </Button>
                            <TextBlock Grid.Row="0" Text="当前页二维码" FontWeight="Medium"
                                       FontSize="14" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,14"/>
                            <Image x:Name="qrImage" Grid.Row="1" Stretch="Uniform" Width="240" Height="240"
                                   HorizontalAlignment="Center"/>
                            <TextBlock x:Name="qrUrl" Grid.Row="2" TextWrapping="Wrap"
                                       FontSize="10" Opacity="0.6" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,0"
                                       MaxHeight="48"/>
                        </Grid>
                    </Border>
                </Border>
                <!-- PDF 侧边批注面板：右侧浮层，WPF 原生实现，跟随窗口 -->
                <Grid x:Name="pdfSidePanel" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      Width="0" Visibility="Collapsed"
                      Margin="0,0,0,0">
                    <Border Background="{DynamicResource ToolbarBg}" CornerRadius="12"
                            Padding="10,12" BorderThickness="0" Margin="4,0,0,0">
                        <DockPanel>
                            <!-- 顶栏：标题 + 折叠 -->
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <Button x:Name="btnPdfPanelCollapse" DockPanel.Dock="Right"
                                            Width="28" Height="28" ToolTip="折叠批注面板"
                                            Click="BtnPdfPanelCollapse_Click"
                                            BorderThickness="0" Background="Transparent">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Fill="{DynamicResource TextColor}"
                                              Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                                    </Button>
                                    <TextBlock Text="PDF 批注" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"/>
                                </DockPanel>
                                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,8,0,8"/>
                            </StackPanel>
                            <!-- 主体：滚动区 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="pdfAnnotPanel">
                                    <!-- 颜色选择区 -->
                                    <TextBlock Text="高亮颜色" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                                    <UniformGrid x:Name="highlightColorGrid" Columns="6" Margin="0,0,0,10" Height="28"/>
                                    <TextBlock Text="文字颜色" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                                    <UniformGrid x:Name="textColorGrid" Columns="7" Margin="0,0,0,10" Height="28"/>
                                    <!-- 操作按钮 -->
                                    <TextBlock Text="批注工具" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                                    <UniformGrid x:Name="pdfToolGrid" Columns="2" Margin="0,0,0,10"/>
                                    <!-- 字号/线宽 -->
                                    <TextBlock Text="文字字号" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="pdfFontSize" Height="26" Margin="0,0,0,10"
                                              SelectedIndex="2">
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="14"/>
                                        <ComboBoxItem Content="18"/>
                                        <ComboBoxItem Content="24"/>
                                        <ComboBoxItem Content="32"/>
                                    </ComboBox>
                                    <TextBlock Text="画线线宽" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="pdfStrokeWidth" Height="24" Minimum="1" Maximum="8" Value="3"
                                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,10"/>
                                    <!-- 底部操作 -->
                                    <Button x:Name="btnPdfUndo" Height="30" Margin="0,0,0,6"
                                            Click="BtnPdfUndo_Click"
                                            Content="↶ 撤销"
                                            Style="{DynamicResource ToolButton}"/>
                                    <Button x:Name="btnPdfClear" Height="30" Margin="0,0,0,6"
                                            Click="BtnPdfClear_Click"
                                            Content="🗑 清除全部"
                                            Style="{DynamicResource ToolButton}"/>
                                    <Button x:Name="btnPdfExport" Height="30" Margin="0,0,0,6"
                                            Click="BtnPdfExport_Click"
                                            Content="📥 导出 PDF"
                                            Style="{DynamicResource ToolButton}"/>
                                    <Button x:Name="btnPdfPrint" Height="30"
                                            Click="BtnPdfPrint_Click"
                                            Content="🖨 打印"
                                            Style="{DynamicResource ToolButton}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 设置页（Edge/Chrome 风格左右分列） -->
            <Grid x:Name="settingsPage" Margin="42,6,6,6" Visibility="Collapsed"
                  Background="{DynamicResource WindowBg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧分类导航 -->
                <Border Grid.Column="0" Background="{DynamicResource ToolbarBg}" CornerRadius="12"
                        Margin="0,0,0,0" Padding="8,12">
                    <StackPanel>
                        <!-- 顶部标题 -->
                        <Grid Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Width="28" Height="28"
                                    Click="BtnCloseSettings_Click" Background="Transparent"
                                    BorderThickness="0" Foreground="{DynamicResource TextColor}"
                                    Cursor="Hand" ToolTip="关闭">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource TextColor}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M2 2l10 10M12 2L2 12"/>
                            </Button>
                            <TextBlock Grid.Column="2" Text="设置" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,4,8,4" Opacity="0.5"/>

                        <!-- 分类列表 -->
                        <ListBox x:Name="lbSettingsNav" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="SettingsNav_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="2,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="navBd" Background="Transparent"
                                                                CornerRadius="6" Height="36" Margin="4,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border x:Name="navIndicator" Grid.Column="0"
                                                                        Background="{DynamicResource AccentBlue}"
                                                                        CornerRadius="2" Width="3" Margin="0,4,0,4"
                                                                        Visibility="Collapsed"/>
                                                            <ContentPresenter Grid.Column="1" Margin="8,0,8,0"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="navBd" Property="Background"
                                                                    Value="{DynamicResource HoverBg}"/>
                                                        <Setter TargetName="navIndicator" Property="Visibility"
                                                                    Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="navBd" Property="Background"
                                                                    Value="{DynamicResource HoverBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Fill="{DynamicResource TextColor}"
                                              Data="{Binding IconData}"
                                              Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   Foreground="{DynamicResource TextColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 分割线 -->
                <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,8"/>

                <!-- 右侧内容区 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 页面标题头部 -->
                        <Grid x:Name="settingsHeader" Margin="32,24,32,16">
                            <StackPanel>
                                <TextBlock x:Name="settingsPageTitle" Text="用户" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"/>
                                <TextBlock x:Name="settingsPageDesc" Text="管理您的用户配置文件" FontSize="13"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 内容区域 -->
                        <ContentControl x:Name="settingsContent" Margin="32,0,32,24"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 下载浮层 -->
            <Grid x:Name="downloadsOverlay" Visibility="Collapsed"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                  MouseDown="DownloadsOverlay_MouseDown">
                <Border Background="{DynamicResource ToolbarBg}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Width="320" MaxHeight="400" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="下载" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                            <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right"
                                    Click="BtnCloseDownloads_Click" Background="Transparent"
                                    BorderThickness="0" Foreground="{DynamicResource TextColor}" Cursor="Hand"/>
                        </Grid>
                        <ListBox x:Name="lbDownloads" Grid.Row="1" Background="Transparent"
                                 BorderThickness="0" Margin="0,8,0,0" MaxHeight="340">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                   Foreground="{DynamicResource TextColor}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Value="{Binding Progress}" Height="4" Margin="0,4,0,0"
                                                     Minimum="0" Maximum="100"
                                                     Foreground="{DynamicResource AccentBlue}"/>
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding SpeedText}" FontSize="10"
                                                       Foreground="{DynamicResource AccentBlue}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="10"
                                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding RemainingText}" FontSize="10"
                                                       Foreground="{DynamicResource TextColor}" Opacity="0.5"
                                                       HorizontalAlignment="Right" Visibility="{Binding Speed, Converter={StaticResource NonZeroToVisible}}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                            <Button Content="打开文件" FontSize="10" Padding="8,2"
                                                    Click="BtnOpenDownloadedFile_Click" Tag="{Binding FilePath}"
                                                    Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" Foreground="{DynamicResource TextColor}"
                                                    Cursor="Hand" Margin="0,0,6,0"/>
                                            <Button Content="打开文件夹" FontSize="10" Padding="8,2"
                                                    Click="BtnOpenDownloadFolder_Click" Tag="{Binding FilePath}"
                                                    Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" Foreground="{DynamicResource TextColor}"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 媒体嗅探浮层 -->
            <Grid x:Name="mediaSnifferOverlay" Visibility="Collapsed"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                  MouseDown="MediaSnifferOverlay_MouseDown">
                <Border Background="{DynamicResource ToolbarBg}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Width="520" MaxHeight="600" Padding="12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="12" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📡 媒体嗅探" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"/>
                                <TextBlock x:Name="mediaCountText" Text="" FontSize="11" Opacity="0.6"
                                           Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"
                                           Margin="8,1,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnClearMediaList" Click="BtnClearMediaList_Click"
                                        Content="清空" FontSize="11" Padding="8,2"
                                        Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Foreground="{DynamicResource TextColor}"
                                        Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Content="✕" Width="24" Height="24"
                                        Click="BtnCloseMediaSniffer_Click" Background="Transparent"
                                        BorderThickness="0" Foreground="{DynamicResource TextColor}" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="lbMedia" Grid.Row="1" Background="Transparent"
                                 BorderThickness="0" MaxHeight="480"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource HoverBg}" CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Padding="8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding KindBadge}" FontSize="13"
                                                           VerticalAlignment="Center" DockPanel.Dock="Left"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Ext}" FontSize="10"
                                                           Foreground="White" VerticalAlignment="Center"
                                                           Background="{DynamicResource AccentBlue}"
                                                           Padding="4,1" DockPanel.Dock="Left"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DisplayTime}" FontSize="10"
                                                           Opacity="0.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextColor}"
                                                           DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                                           Foreground="{DynamicResource TextColor}"
                                                           Opacity="0.7" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DisplayUrl}" FontSize="11"
                                                       Foreground="{DynamicResource TextColor}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                       ToolTip="{Binding Url}"/>
                                            <TextBlock Text="{Binding PageTitle}" FontSize="10"
                                                       Foreground="{DynamicResource TextColor}" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <!-- 下载状态行：进度文本 + 线程 + 速度 + ETA -->
                                            <Grid Margin="0,4,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="10" Opacity="0.7"
                                                           Foreground="{DynamicResource TextColor}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding DownloadedText}"/>
                                                    <Run Text="/"/>
                                                    <Run Text="{Binding SizeText}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding ThreadsText}" FontSize="10"
                                                           Foreground="#3498db" VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SpeedText}" FontSize="10"
                                                           Foreground="#27ae60" VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding EtaText}" FontSize="10"
                                                           Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <!-- 状态/进度条 -->
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Status}" FontSize="10"
                                                           Foreground="{DynamicResource TextColor}" Opacity="0.75"
                                                           HorizontalAlignment="Left"/>
                                                <ProgressBar Value="{Binding Progress}" Height="3"
                                                             Minimum="0" Maximum="100"
                                                             Foreground="#27ae60"
                                                             HorizontalAlignment="Stretch"
                                                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="⬇ 下载" FontSize="10" Padding="8,2"
                                                        Click="BtnDownloadMedia_Click" Tag="{Binding}"
                                                        Background="Transparent" BorderBrush="{DynamicResource AccentBlue}"
                                                        BorderThickness="1" Foreground="{DynamicResource AccentBlue}"
                                                        Cursor="Hand" Margin="0,0,6,0"/>
                                                <Button Content="📋 复制URL" FontSize="10" Padding="8,2"
                                                        Click="BtnCopyMediaUrl_Click" Tag="{Binding}"
                                                        Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" Foreground="{DynamicResource TextColor}"
                                                        Cursor="Hand" Margin="0,0,6,0"/>
                                                <Button Content="✕" FontSize="10" Padding="6,2"
                                                        Click="BtnRemoveMedia_Click" Tag="{Binding}"
                                                        Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" Foreground="#e74c3c"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 收藏夹浮层 -->
            <Grid x:Name="bookmarksOverlay" Visibility="Collapsed"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                  MouseDown="BookmarksOverlay_MouseDown">
                <Border Background="{DynamicResource ToolbarBg}" CornerRadius="8"
                        Width="320" MaxHeight="400" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="收藏夹" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                            <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right"
                                    Click="BtnCloseBookmarks_Click" Background="Transparent"
                                    BorderThickness="0" Foreground="{DynamicResource TextColor}" Cursor="Hand"/>
                        </Grid>
                        <ListBox x:Name="lbBookmarksPopup" Grid.Row="1" Background="Transparent"
                                 BorderThickness="0" Margin="0,8,0,0" MaxHeight="340"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                        Padding="6,4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="{DynamicResource AccentBlue}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Click="BookmarkItem_Click"
                                                Tag="{Binding Url}" Background="Transparent"
                                                BorderThickness="0" HorizontalContentAlignment="Left"
                                                Padding="0" Cursor="Hand">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       Foreground="{DynamicResource TextColor}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                        <Button Grid.Column="1" Content="✕" Width="20" Height="20"
                                                Click="BtnDeleteBookmark_Click" Tag="{Binding Url}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource TextColor}" FontSize="10"
                                                Cursor="Hand" Opacity="0.4">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 脚本编辑浮层 -->
            <Grid x:Name="scriptEditorOverlay" Visibility="Collapsed" Background="#80000000">
                <Border Background="{DynamicResource ToolbarBg}" CornerRadius="10" Width="560"
                        Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtScriptEditorTitle" Grid.Row="0" Text="添加脚本"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,12"/>
                        <TextBox x:Name="txtScriptName" Grid.Row="1" Height="30" Margin="0,0,0,8"
                                 Style="{DynamicResource UrlBox}" VerticalContentAlignment="Center"
                                 ToolTip="脚本名称"/>
                        <TextBox x:Name="txtScriptMatch" Grid.Row="2" Height="30" Margin="0,0,0,8"
                                 Style="{DynamicResource UrlBox}" VerticalContentAlignment="Center"
                                 ToolTip="匹配规则，如 *://*/*"/>
                        <TextBox x:Name="txtScriptCode" Grid.Row="3" Margin="0,0,0,8"
                                 Style="{DynamicResource UrlBox}" AcceptsReturn="True"
                                 AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                 ToolTip="JavaScript 代码"/>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Width="80" Height="30" Margin="0,0,8,0"
                                    Click="BtnCancelScript_Click"/>
                            <Button Content="保存" Width="80" Height="30"
                                    Click="BtnSaveScript_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 搜索引擎编辑浮层 -->
            <Grid x:Name="engineEditorOverlay" Visibility="Collapsed" Background="#80000000">
                <Border Background="{DynamicResource ToolbarBg}" CornerRadius="10" Width="460"
                        Height="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtEngineEditorTitle" Grid.Row="0" Text="添加搜索引擎"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Text="名称" FontSize="12"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtEngineName" Grid.Row="2" Height="28" Margin="0,0,0,8"
                                 Style="{DynamicResource UrlBox}" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="3" Text="快捷关键字（地址栏输入 关键字+空格+搜索词 触发）" FontSize="12"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtEngineKeyword" Grid.Row="4" Height="28" Margin="0,0,0,8"
                                 Style="{DynamicResource UrlBox}" VerticalContentAlignment="Center"
                                 ToolTip="如 gh、bd、so"/>
                        <TextBlock Grid.Row="5" Text="搜索 URL（用 %s 代替关键词）" FontSize="12"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtEngineUrl" Grid.Row="6" Height="28" Margin="0,0,0,8"
                                 Style="{DynamicResource UrlBox}" VerticalContentAlignment="Center"
                                 ToolTip="如 https://github.com/search?q=%s"/>
                        <TextBlock Grid.Row="7" Text="搜索建议接口（可选，用 %s 代替关键词）" FontSize="12"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtEngineSuggest" Grid.Row="8" Height="28" Margin="0,0,0,8"
                                 Style="{DynamicResource UrlBox}" VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Width="80" Height="30" Margin="0,0,8,0"
                                    Click="BtnCancelEngine_Click"/>
                            <Button Content="保存" Width="80" Height="30"
                                    Click="BtnSaveEngine_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- 下载完成通知 Toast -->
        <Border x:Name="downloadToast" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" CornerRadius="8"
                Background="{DynamicResource ToolbarBg}"
                BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1"
                Padding="14,10" Cursor="Hand" MouseDown="ToastOpenFile_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="下载完成" FontSize="11" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="toastText" FontSize="12" Foreground="{DynamicResource TextColor}"
                               TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="打开" FontSize="11" Foreground="{DynamicResource AccentBlue}"
                           VerticalAlignment="Center" Margin="12,0,0,0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
