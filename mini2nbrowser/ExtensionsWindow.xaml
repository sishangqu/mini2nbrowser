<Window x:Class="mini2nbrowser.ExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:mini2nbrowser"
        Title="扩展管理" Height="600" Width="640"
        Icon="/app.ico"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        Background="{DynamicResource WindowBg}"
        MinHeight="480" MinWidth="560"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="rootGrid" Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（可拖动） -->
        <Grid Grid.Row="0" Background="{DynamicResource ToolbarBg}"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <!-- 拼图图标 -->
                <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                      Fill="{DynamicResource AccentBlue}"
                      Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z"/>
                <TextBlock Text="扩展管理" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnMinimize" Click="BtnMinimize_Click"
                        Style="{DynamicResource CaptionBtn}" Width="46" Height="44">
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource TextColor}" StrokeThickness="1.5"
                          Data="M0 5h10"/>
                </Button>
                <Button x:Name="btnClose" Click="BtnClose_Click"
                        Style="{DynamicResource CaptionCloseBtn}" Width="46" Height="44">
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource TextColor}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M0 0l10 10M10 0L0 10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 安全提示 -->
            <Border Grid.Row="0" Background="{DynamicResource HoverBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                          Fill="#E84C3D" VerticalAlignment="Center"
                          Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                    <TextBlock Text="仅导入可信来源扩展，第三方扩展存在安全风险"
                               Foreground="{DynamicResource TextColor}" Opacity="0.85"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 操作按钮区 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10">
                <Button x:Name="btnImportCrx" Click="BtnImportCrx_Click"
                        Width="130" Height="30" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource TextColor}"
                              Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                        <TextBlock Text="导入 CRX" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnImportFolder" Click="BtnImportFolder_Click"
                        Width="160" Height="30">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource TextColor}"
                              Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                        <TextBlock Text="导入解压扩展文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 扩展列表 -->
            <Grid Grid.Row="2" Margin="14,0,14,14">
                <ListBox x:Name="lbExtensions" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource HoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 图标 -->
                                <Border Grid.Column="0" Width="36" Height="36"
                                        Background="{DynamicResource HoverBg}" CornerRadius="6"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="imgIcon" Width="28" Height="28"
                                               Stretch="Uniform" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- 无图标时显示首字母占位 -->
                                        <TextBlock x:Name="txtFallback" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBlue}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- 名称/版本/描述 -->
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColor}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                        <TextBlock Text="{Binding Version, StringFormat=' v{0}'}" FontSize="11"
                                                   Foreground="{DynamicResource TextColor}" Opacity="0.55"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="chkEnabled" IsChecked="{Binding Enabled}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                              Checked="ChkEnabled_Checked" Unchecked="ChkEnabled_Unchecked"
                                              Tag="{Binding Id}" ToolTip="启用/禁用"/>
                                    <Button Click="BtnDelete_Click" Tag="{Binding Id}"
                                            Width="56" Height="26" FontSize="11" Content="删除"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IconRelPath}" Value="">
                                    <Setter TargetName="imgIcon" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                    <Path Width="48" Height="48" Stretch="Uniform" Margin="0,0,0,12"
                          Fill="{DynamicResource TextColor}" Opacity="0.25"
                          HorizontalAlignment="Center"
                          Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z"/>
                    <TextBlock Text="暂无扩展，点击上方按钮导入" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Opacity="0.45"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 不支持提示 -->
                <Border x:Name="unsupportedTip" Visibility="Collapsed"
                        Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="20"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxWidth="500">
                    <StackPanel>
                        <TextBlock Text="WebView2 运行时版本过低" FontSize="14" FontWeight="Bold"
                                   Foreground="#E84C3D" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="扩展功能需要 WebView2 Runtime ≥ 1.0.2045。请更新 WebView2 Runtime 后重启应用。"
                                   FontSize="12" Foreground="{DynamicResource TextColor}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
